package eclipse

import (
	"testing"

	"github.com/stretchr/testify/require"
)

func TestOR(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	requireT.Equal(
		[]uint64{0b10101010},
		OR(
			[]uint64{},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b11010101},
		OR(
			[]uint64{0b11010101},
			[]uint64{},
		),
	)

	requireT.Equal(
		[]uint64{},
		OR(
			[]uint64{},
			[]uint64{},
		),
	)

	requireT.Equal(
		[]uint64{0b10101010},
		OR(
			nil,
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b11010101},
		OR(
			[]uint64{0b11010101},
			nil,
		),
	)

	requireT.Equal(
		[]uint64{},
		OR(
			nil,
			nil,
		),
	)

	requireT.Equal(
		[]uint64{0b11110111},
		OR(
			[]uint64{0b11010101},
			[]uint64{0b10100111},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101},
		OR(
			[]uint64{0b00000010, 0b11010101},
			[]uint64{0b10100111},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101},
		OR(
			[]uint64{0b10100111},
			[]uint64{0b00000010, 0b11010101},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101, 0b10001000},
		OR(
			[]uint64{0b00000010, 0b11010101},
			[]uint64{0b10100111, 0b00000010, 0b10001000},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101, 0b10001000},
		OR(
			[]uint64{0b10100111, 0b00000010, 0b10001000},
			[]uint64{0b00000010, 0b11010101},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101, 0b10011100},
		OR(
			[]uint64{0b10100111, 0b00000010, 0b10001000},
			[]uint64{0b00000010, 0b11010101, 0b10010100},
		),
	)

	requireT.Equal(
		[]uint64{0b10100111, 0b00000001, 0b11010101, 0b10011100},
		OR(
			[]uint64{0b00000010, 0b11010101, 0b10010100},
			[]uint64{0b10100111, 0b00000010, 0b10001000},
		),
	)
}

func TestAND(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{0b11010101},
			[]uint64{},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{},
			[]uint64{},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			nil,
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{0b11010101},
			nil,
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			nil,
			nil,
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{0b11010101},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{0b00000001, 0b10101010},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{},
		AND(
			[]uint64{0b10101010},
			[]uint64{0b00000001, 0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b10101010},
		AND(
			[]uint64{0b10101010},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b10101010},
		AND(
			[]uint64{0b10101010, 0b10000001},
			[]uint64{0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b10101010},
		AND(
			[]uint64{0b10101010},
			[]uint64{0b10101010, 0b10000001},
		),
	)

	requireT.Equal(
		[]uint64{0b00000001, 0b10001000},
		AND(
			[]uint64{0b00000001, 0b10101010},
			[]uint64{0b10101010, 0b10001101},
		),
	)

	requireT.Equal(
		[]uint64{0b00000001, 0b10001000},
		AND(
			[]uint64{0b10101010, 0b10001101},
			[]uint64{0b00000001, 0b10101010},
		),
	)

	requireT.Equal(
		[]uint64{0b00000010, 0b10101010, 0b10001101},
		AND(
			[]uint64{0b00000010, 0b10101010, 0b11111111},
			[]uint64{0b10101010, 0b10000000, 0b11111111, 0b10001101},
		),
	)

	requireT.Equal(
		[]uint64{0b00000010, 0b10101010, 0b10001101},
		AND(
			[]uint64{0b10101010, 0b10000000, 0b11111111, 0b10001101},
			[]uint64{0b00000010, 0b10101010, 0b11111111},
		),
	)

	requireT.Equal(
		[]uint64{0b00000010, 0b10101010, 0b10001101, 0b00000010, 0b10001000},
		AND(
			[]uint64{0b00000010, 0b10101010, 0b11111111, 0b00000001, 0b10000010, 0b10111000},
			[]uint64{0b10101010, 0b10000001, 0b11111111, 0b10001101, 0b11111111, 0b00000001, 0b10001111},
		),
	)

	requireT.Equal(
		[]uint64{0b00000010, 0b10101010, 0b10001101, 0b00000010, 0b10001000},
		AND(
			[]uint64{0b10101010, 0b10000001, 0b11111111, 0b10001101, 0b11111111, 0b00000001, 0b10001111},
			[]uint64{0b00000010, 0b10101010, 0b11111111, 0b00000001, 0b10000010, 0b10111000},
		),
	)

	requireT.Equal(
		[]uint64{0b00000011, 0b10001101, 0b00000010, 0b10001000},
		AND(
			[]uint64{0b00000010, 0b11110000, 0b11111111, 0b00000001, 0b10000010, 0b10111000},
			[]uint64{0b10101010, 0b10000001, 0b10001111, 0b10001101, 0b11111111, 0b00000001, 0b10001111},
		),
	)

	requireT.Equal(
		[]uint64{0b00000011, 0b10001101, 0b00000010, 0b10001000},
		AND(
			[]uint64{0b10101010, 0b10000001, 0b10001111, 0b10001101, 0b11111111, 0b00000001, 0b10001111},
			[]uint64{0b00000010, 0b11110000, 0b11111111, 0b00000001, 0b10000010, 0b10111000},
		),
	)

	requireT.Equal(
		[]uint64{0b00000011, 0b10001101},
		AND(
			[]uint64{0b00000010, 0b11110000, 0b11111111, 0b00000001, 0b10000010, 0b11111000},
			[]uint64{0b10101010, 0b10000001, 0b10001111, 0b10001101, 0b11111111, 0b00000001, 0b10000111},
		),
	)

	requireT.Equal(
		[]uint64{0b00000011, 0b10001101},
		AND(
			[]uint64{0b10101010, 0b10000001, 0b10001111, 0b10001101, 0b11111111, 0b00000001, 0b10000111},
			[]uint64{0b00000010, 0b11110000, 0b11111111, 0b00000001, 0b10000010, 0b11111000},
		),
	)
}
