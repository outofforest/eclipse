package eclipse

import (
	"testing"

	"github.com/stretchr/testify/require"
)

func TestIteratorNextEmpty(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{})

	b, i, ok := it.Next()
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

func TestIteratorNext1(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b10000001})

	b, i, ok := it.Next()
	requireT.True(ok)
	requireT.Zero(i)
	requireT.EqualValues(0b10000001, b)

	b, i, ok = it.Next()
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

func TestIteratorNext2(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b10000001, 0b11111111})

	b, i, ok := it.Next()
	requireT.True(ok)
	requireT.Zero(i)
	requireT.EqualValues(0b10000001, b)

	b, i, ok = it.Next()
	requireT.True(ok)
	requireT.EqualValues(1, i)
	requireT.EqualValues(0b11111111, b)

	b, i, ok = it.Next()
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

func TestIteratorNext3(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b00000001, 0b10000001, 0b11111111})

	b, i, ok := it.Next()
	requireT.True(ok)
	requireT.EqualValues(1, i)
	requireT.EqualValues(0b10000001, b)

	b, i, ok = it.Next()
	requireT.True(ok)
	requireT.EqualValues(2, i)
	requireT.EqualValues(0b11111111, b)

	b, i, ok = it.Next()
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

func TestIteratorNext4(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b01111111, 0b10000001, 0b11111111})

	b, i, ok := it.Next()
	requireT.True(ok)
	requireT.EqualValues(127, i)
	requireT.EqualValues(0b10000001, b)

	b, i, ok = it.Next()
	requireT.True(ok)
	requireT.EqualValues(128, i)
	requireT.EqualValues(0b11111111, b)

	b, i, ok = it.Next()
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

