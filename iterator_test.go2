func TestIteratorForwardEmpty(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{})

	b, i, ok := it.Forward(5)
	requireT.False(ok)
	requireT.Zero(i)
	requireT.Zero(b)
}

func TestIteratorForward1(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b10000001, 0b10000010})

	b, i, ok := it.Forward(1)
	requireT.True(ok)
	requireT.EqualValues(1, i)
	requireT.EqualValues(0b10000010, b)
}

func TestIteratorForward2(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b10000001, 0b10000010, 0b10000100})

	it.Next()

	b, i, ok := it.Forward(2)
	requireT.True(ok)
	requireT.EqualValues(2, i)
	requireT.EqualValues(0b10000100, b)
}

func TestIteratorForward3(t *testing.T) {
	t.Parallel()

	requireT := require.New(t)

	it := newIterator([]uint64{0b00000001, 0b10000010, 0b00000001, 0b10000100})

	it.Next()

	b, i, ok := it.Forward(3)
	requireT.True(ok)
	requireT.EqualValues(3, i)
	requireT.EqualValues(0b10000100, b)
}
